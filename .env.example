# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
#
# Every key is OPTIONAL for local exploration. With all keys left empty,
# synthetic demo leads, audits, and outreach drafts use deterministic built-in
# fallbacks. Persistent real-business research stops visibly until Google
# Places is configured, and nothing external is called or sent by default.
# ---------------------------------------------------------------------------

# Your studio identity, used in outreach drafts and the email From header.
STUDIO_NAME=
SENDER_NAME=

# Server-only OpenAI credential for AI audits and outreach drafts.
# Leave empty to use the deterministic fallback generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google Places Text Search (New) for finding real local businesses.
# Leave empty to keep real-business research disabled. The manual demo-lead
# path can still create deterministic `.example` businesses locally.
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights API for evidence-based website audits.
PAGESPEED_API_KEY=

# Gmail OAuth server credentials. Keep every value server-only.
# All four are required before any real email can be sent.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# e.g. you@yourdomain.com — must match the authorized Gmail account.
GMAIL_SENDER=

# Physical mailing address required by anti-spam law (CAN-SPAM/GDPR) before
# real commercial outreach can be enabled.
OUTREACH_POSTAL_ADDRESS=

# Master kill switch. Keep false during research and testing. Set true only
# for an intentional, owner-reviewed outreach launch.
OUTREACH_LAUNCH_ENABLED=false

# Required server-side owner allowlist for every hosted environment.
OWNER_EMAIL=

# Development only. Production ignores this flag even when it is true.
# Set to true to open the dashboard on localhost without sign-in.
ALLOW_LOCAL_OWNER_BYPASS=false

# Optional website intake adapter for handing generated concepts to an
# external site pipeline. It remains disabled (fail-closed) unless all three
# values are configured through secure server-side deployment controls.
EVELE_WEBSITE_BASE_URL=
EVELE_WEBSITE_API_TOKEN=
EVELE_WEBSITE_IMPORT_WORKER_ID=
